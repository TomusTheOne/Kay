# ============================================================================
# Kay Diving — Apache configuration for OVH shared hosting.
# The site is a static export, so Next's own headers() and middleware never
# run: everything they used to do lives here.
# ============================================================================

Options -Indexes
# index.php for /admin/, which has no static page in front of it.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- One host, so the same page is never indexed twice ---------------------
  # Three names resolve to this same document root: the domain, its www form,
  # and the technical <account>.clusterNNN.hosting.ovh.net that OVH creates.
  # Left alone, Google can index all three and split the ranking between them.
  # Anything that is not the canonical host goes there, and straight to https,
  # so a wrong host on http costs one redirect rather than two.
  # The host is written by build-deploy.mjs from the same SITE_URL the pages
  # are built with, so this and <link rel="canonical"> cannot disagree.
  RewriteCond %{HTTP_HOST} !^__CANONICAL_HOST_RE__$ [NC]
  RewriteRule ^(.*)$ https://__CANONICAL_HOST__/$1 [R=301,L]

  # --- HTTPS only, for requests already on the right host --------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- The bare root goes to the default locale -----------------------------
  # Absolute, because a relative target makes Apache build the Location from
  # its own server name and port: the live site was answering
  # "https://kaydiving.com:443/en/", a different URL to anything that links
  # to it.
  RewriteRule ^$ https://__CANONICAL_HOST__/en/ [R=302,L]

  # --- Leave the PHP endpoints and real files alone -------------------------
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Do not advertise the stack.
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# --- The endpoints are not pages --------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(php|json)$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# --- Caching ----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Content-hashed by Next: safe to keep for a year.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "public, immutable"
  </FilesMatch>
  # Photographs and illustrations are never edited in place.
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|ico)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "public, immutable"
  </FilesMatch>
  # HTML, the sitemap and the manifest must always be revalidated, or a price
  # change never reaches anyone.
  <FilesMatch "\.(html|xml|webmanifest)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Types Apache does not know on its own ----------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/avif   .avif
  AddType image/webp   .webp
  AddType font/woff2   .woff2
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml \
    application/manifest+json application/xml
</IfModule>

# --- Nothing sensitive is ever served ---------------------------------------
<FilesMatch "^(\.env.*|.*\.sql|.*\.json\.bak|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
# The PHP test runner has no business being reachable.
RedirectMatch 404 ^/api/tests/
# Nor has the library: booking.php and webhook.php include these, nobody
# fetches them. They execute to an empty body today, which is harmless — but
# only for as long as PHP keeps running. One misconfiguration and they would
# be served as source, with the database and Mercado Pago handling in them.
RedirectMatch 404 ^/api/lib/
# Refuses to run outside the command line anyway, but a script whose job is
# to send mail does not get to rely on one guard.
RedirectMatch 404 ^/api/send-live\.php$
# The catalogue the PHP reads off disk. It holds nothing secret — the same
# prices are on the page — but it has no reason to be a public endpoint, and
# nothing in the browser asks for it: the site compiles it into its bundle.
RedirectMatch 404 ^/api/products\.json$
# Same for the copy of the translations the confirmation emails render from.
RedirectMatch 404 ^/api/messages/
# The admin's bootstrap: it loads the library and sets headers, and has no
# business being requested on its own. Every admin page that is meant to be
# opened checks the session itself.
RedirectMatch 404 ^/admin/_

ErrorDocument 404 /404.html
